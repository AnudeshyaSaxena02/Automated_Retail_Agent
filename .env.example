# ============================================================
# IDAM — Intelligent Automated Retail Store Backend
# .env.example
#
# PURPOSE: This is a TEMPLATE file.
#          Copy this to .env and fill in your real values.
#          NEVER commit .env to git.
#
# Usage:   copy .env.example .env
# ============================================================

# ----------------------------
# Application Settings
# ----------------------------
APP_NAME=IDAM Retail Store Backend
APP_VERSION=1.0.0
DEBUG=True

# ----------------------------
# Database (Phase 2)
# ----------------------------
# SQLite database file path (relative to project root)
# The 'data/' folder will be created automatically on first run.
DATABASE_URL=sqlite:///./data/idam.db

# ----------------------------
# LLM — Provider Selection (Phase 6)
# ----------------------------
# Which provider to use as primary.
# The other provider is used as automatic fallback.
# Supported values: groq, gemini
LLM_PROVIDER=groq

# Seconds to wait before raising a timeout error (5–120)
LLM_TIMEOUT=30

# ----------------------------
# LLM — Groq Free API (Phase 6)
# ----------------------------
# Get your free API key at: https://console.groq.com
# Sign up → API Keys → Create API Key (instant, free)
GROQ_API_KEY=your_groq_api_key_here

# Recommended free model — very fast, high quality
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------
# LLM — Google Gemini Free (Phase 6, Fallback)
# ----------------------------
# Get your free API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Free tier model
GEMINI_MODEL=gemini-1.5-flash

# ----------------------------
# Embeddings (Phase 4)
# ----------------------------
# Local model — downloads once (~22MB), then runs offline
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----------------------------
# ChromaDB Vector Store (Phase 4)
# ----------------------------
# Local folder where ChromaDB stores product embeddings
CHROMA_DB_PATH=./data/chroma_db

# ----------------------------
# Semantic Search (Phase 5)
# ----------------------------
# Minimum similarity score for search results (0.0–1.0)
# 0.3 = recommended default
SIMILARITY_THRESHOLD=0.3

# ----------------------------
# RAG Pipeline (Phase 7)
# ----------------------------
# How many products to retrieve from ChromaDB per RAG query (1–20)
RAG_TOP_K=5
